{
  "name": "dsh-backlog.md",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness plugin embedding the Backlog.md Markdown kanban board in a sidebar panel and conversation tab, with one backlog browser process per workspace.",
  "license": "MIT",
  "author": "kuwork",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "backlog",
    "backlog.md",
    "kanban",
    "kanban-board",
    "markdown",
    "task-management",
    "project-management",
    "ai-agent",
    "ai-coding",
    "claude-code",
    "git-native",
    "local-first",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuwork/DSH-Backlog.md.git"
  },
  "homepage": "https://github.com/kuwork/DSH-Backlog.md#readme",
  "bugs": {
    "url": "https://github.com/kuwork/DSH-Backlog.md/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    ".github/*.jpg",
    ".github/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
